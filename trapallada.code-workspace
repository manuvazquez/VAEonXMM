{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"__marimo__": true,
			".venv": true,
			"**/__pycache__": true,
			"**/*.aux": true,
			"**/*.csv": true,
			"**/*.dat": true,
			"**/*.egg-info": true,
			"**/*.eqx": true,
			"**/*.FTZ": true,
			"**/*.html": true,
			"**/*.log": true,
			"**/*.parquet": true,
			"**/*.pdf": true,
			"**/*.PNG": true,
			"**/*.synctex.gz": true,
			"**/*.tar": true,
			"**/*.xlsx": true,
			"**/iframe_figures": true,
			"LICENSE": true,
			"results/*.yaml": true,
			"results/new/logs": true
		},
		"editor.wordWrap": "on",
		"outline.collapseItems": "alwaysCollapse",
		"git.ignoreLimitWarning": true
	},
}